      "name": "Wyczyść tabelę",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        896,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Ustawienia\nconst INCLUDE_ARCHIVED = false;\nconst SKIP_TYPES = ['n8n-nodes-base.stickyNote'];\n\nconst pages = $('Pobierz workflowy (API, paginacja)').all();\nconst scannedAt = new Date().toISOString();\nconst stats = {};\nconst seenWf = new Set();\n\nfor (const page of pages) {\n  const list = Array.isArray(page.json.data) ? page.json.data : [];\n  for (const wf of list) {\n    if (!wf || !wf.id || seenWf.has(wf.id)) continue;\n    if (wf.isArchived && !INCLUDE_ARCHIVED) continue;\n    seenWf.add(wf.id);\n    for (const n of wf.nodes || []) {\n      if (!n.type || SKIP_TYPES.includes(n.type)) continue;\n      if (!stats[n.type]) stats[n.type] = { occurrences: 0, workflows: new Map(), versions: new Set() };\n      const s = stats[n.type];\n      s.occurrences += 1;\n      s.workflows.set(wf.id, wf.name);\n      s.versions.add(String(n.typeVersion));\n    }\n  }\n}\n\nfunction category(type) {\n  if (/trigger$/i.test(type)) return 'trigger';\n  if (type.startsWith('@n8n/n8n-nodes-langchain.')) return 'ai';\n  if (type.startsWith('n8n-nodes-base.')) return 'core';\n  return 'community';\n}\n\nreturn Object.entries(stats)\n  .map(([nodeType, s]) => ({\n    json: {\n      nodeType,\n      category: category(nodeType),\n      occurrences: s.occurrences,\n      workflowCount: s.workflows.size,\n      workflows: [...s.workflows.values()].sort().join(', '),\n      typeVersions: [...s.versions].sort().join(', '),\n      scannedAt,\n    },\n  }))\n  .sort((a, b) => b.json.workflowCount - a.json.workflowCount || b.json.occurrences - a.json.occurrences || a.json.nodeType.localeCompare(b.json.nodeType));\n"
      },
